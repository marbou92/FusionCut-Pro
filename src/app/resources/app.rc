// FusionCut Pro - Windows resource script.
//
// Embeds the brand icon into FusionCutPro.exe so Windows Explorer, the
// taskbar, Alt-Tab and the Windows 7 tray all show the Fc mark instead
// of the generic application icon (suggestion #128 / #130). The same
// artwork ships through brand.qrc for the Qt-side QIcon users.
//
// The VERSIONINFO block mirrors cmake/version.h.in; keep the two in
// sync when the version bumps (CI's version-stamped portable readme
// leg already keys off the project version).

#include <windows.h>

IDI_ICON1 ICON "fusioncut.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION    0,1,0
 PRODUCTVERSION 0,1,0
 FILEFLAGSMASK  0x3fL
 FILEFLAGS      0x0L
 FILEOS         VOS_NT_WINDOWS32
 FILETYPE       VFT_APP
 FILESUBTYPE    0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "FusionCut"
            VALUE "FileDescription",  "FusionCut Pro - dual-mode video editor"
            VALUE "FileVersion",      "0.1.0"
            VALUE "ProductName",      "FusionCut Pro"
            VALUE "ProductVersion",   "0.1.0"
            VALUE "OriginalFilename", "FusionCutPro.exe"
            VALUE "LegalCopyright",   "GPL-3.0-or-later"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
