<UserControl x:Class="FfxTool.Gui.ConvertPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:FfxTool.Gui"
             AllowDrop="True" DragEnter="Page_DragEnter" DragLeave="Page_DragLeave" Drop="Page_Drop">
    <Grid Margin="32,24,32,24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Convert Preset" Style="{StaticResource TitlePage}" Margin="0,0,0,20"/>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.12*" MinWidth="380"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="1*" MinWidth="360"/>
            </Grid.ColumnDefinitions>

            <!-- ================= LEFT: workspace ================= -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- hero drop zone — the whole tile is clickable and swaps
                     to the effect checklist once a preset is loaded -->
                <Grid Grid.Row="0" Margin="0,0,0,16">
                    <Border x:Name="Hero" CornerRadius="24" Cursor="Hand" MouseLeftButtonUp="Hero_Click"
                            ToolTip="Click to browse — or drop an .ffx file anywhere on this page">
                        <!-- bg lives ONLY here so the IsMouseOver trigger can swap it
                             (a local attribute would outrank any trigger) -->
                        <Border.Style>
                            <Style TargetType="Border">
                                <Setter Property="Background" Value="{DynamicResource B.SCLow}"/>
                                <Style.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter Property="Background" Value="{DynamicResource B.SCHigh}"/>
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <Border Width="92" Height="92" CornerRadius="46" Background="{DynamicResource B.SC}"
                                    HorizontalAlignment="Center" Margin="0,0,0,16">
                                <controls:IconGlyph IconName="FolderOpen" Width="44" Height="44"
                                                    Foreground="{DynamicResource B.Primary}"/>
                            </Border>
                            <TextBlock Text="Drop a preset to begin" Style="{StaticResource SectionTitle}"
                                       FontSize="17" HorizontalAlignment="Center" Margin="0,0,0,8"/>
                            <TextBlock Text="Drag an After Effects .ffx file — or a whole folder of them — anywhere onto this window, or click to browse."
                                       Style="{StaticResource BodySecondary}" TextAlignment="Center"
                                       MaxWidth="420" TextWrapping="Wrap" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                            <TextBlock Text="Ctrl+O works from anywhere too" Style="{StaticResource Caption}"
                                       HorizontalAlignment="Center" Opacity="0.75"/>
                        </StackPanel>
                    </Border>
                    <Rectangle RadiusX="24" RadiusY="24" Fill="Transparent"
                               Stroke="{DynamicResource B.OutlineVariant}" StrokeThickness="1.5"
                               StrokeDashArray="4 3" IsHitTestVisible="False"/>
                    <!-- effect checklist (replaces the empty state) -->
                    <ListBox x:Name="EffectList" Visibility="Collapsed" Margin="4"
                             ScrollViewer.VerticalScrollBarVisibility="Auto">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Style="{StaticResource Md3CheckBox}" IsChecked="{Binding IsChecked, Mode=TwoWay}"
                                          Margin="8,2">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding MatchName}" Style="{StaticResource Body}" FontWeight="Medium"/>
                                        <TextBlock Text="{Binding VendorLabel}" Style="{StaticResource Caption}" Margin="10,1,0,0"/>
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <!-- folder queue: swaps in for the hero/checklist when a
                         whole folder (or several files) is loaded — one
                         conversion job per .ffx, settings below apply to all -->
                    <Border x:Name="QueueCard" Visibility="Collapsed" CornerRadius="24"
                            Background="{DynamicResource B.SCLow}" Margin="4" Padding="22,18">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <controls:IconGlyph IconName="FolderOpen" Width="22" Height="22"
                                                    Foreground="{DynamicResource B.Primary}" VerticalAlignment="Center"/>
                                <TextBlock x:Name="QueueText" Text="Folder queue" Style="{StaticResource Body}" FontWeight="Medium"
                                           Margin="10,0,0,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                            </StackPanel>
                            <TextBlock x:Name="QueueSub" Style="{StaticResource Caption}" Opacity="0.85" Margin="32,4,0,0"
                                       Text="One conversion per preset — the settings here apply to every file."/>
                            <StackPanel Orientation="Horizontal" Margin="32,14,0,0">
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="Scan" Style="{StaticResource FieldLabel}"/>
                                    <CheckBox x:Name="QueueRecursive" Style="{StaticResource Md3CheckBox}" Content="Include subfolders"
                                              IsChecked="True" Checked="QueueOption_Changed" Unchecked="QueueOption_Changed"/>
                                </StackPanel>
                                <StackPanel Margin="0,0,28,0">
                                    <TextBlock Text="Effects" Style="{StaticResource FieldLabel}"/>
                                    <CheckBox x:Name="RemoveMissingCheck" Style="{StaticResource Md3CheckBox}"
                                              Content="Remove effects missing from my profile"/>
                                </StackPanel>
                                <StackPanel>
                                    <TextBlock Text="Output" Style="{StaticResource FieldLabel}"/>
                                    <ComboBox x:Name="QueueOutput" Width="270" HorizontalAlignment="Left">
                                        <ComboBoxItem Content="Subfolder &quot;converted&quot; inside the source"/>
                                        <ComboBoxItem Content="Beside originals, with a version suffix"/>
                                        <ComboBoxItem Content="Overwrite the original files"/>
                                    </ComboBox>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>

                <!-- file status row -->
                <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,14">
                    <Border Style="{StaticResource Chip}" x:Name="StatusChip">
                        <StackPanel Orientation="Horizontal">
                            <controls:IconGlyph IconName="Info" Width="16" Height="16"
                                                Foreground="{DynamicResource B.OnSurfaceVariant}" VerticalAlignment="Center"/>
                            <TextBlock x:Name="StatusText" Text="No file loaded" Style="{StaticResource BodySecondary}"
                                       Margin="8,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="FolderBtn" Content="Open folder…" Style="{StaticResource OutlinedButton}"
                            MinWidth="118" Margin="10,0,0,0" Click="FolderBtn_Click" VerticalAlignment="Center"
                            ToolTip="Load every .ffx in a folder and convert them all in one pass"/>
                </StackPanel>

                <!-- options card -->
                <Border Grid.Row="2" Style="{StaticResource Card}" Padding="18,14,18,14" Margin="0,0,0,16">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,28,0">
                            <TextBlock Text="Target version" Style="{StaticResource FieldLabel}"/>
                            <ComboBox x:Name="TargetCombo" Width="210" HorizontalAlignment="Left"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1">
                            <TextBlock Text="Output" Style="{StaticResource FieldLabel}"/>
                            <CheckBox x:Name="OverwriteCheck" Style="{StaticResource Md3CheckBox}" Content="Overwrite original file"/>
                            <TextBlock Text="Unchecked: saves a copy next to the original with an automatic version suffix."
                                       Style="{StaticResource Caption}" TextWrapping="Wrap" MaxWidth="300"
                                       Margin="30,5,0,0" Opacity="0.85"/>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- full-width expressive CTA — content doubles as a summary of the pending job;
                     the cancel link only shows while a folder job is running -->
                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <Button x:Name="ConvertBtn" Content="Load a preset to start conversion" Height="48"
                            IsEnabled="False" Click="Convert_Click"/>
                    <TextBlock x:Name="CancelLink" Grid.Column="1" Text="Cancel" Style="{StaticResource M3Link}" Cursor="Hand"
                               Visibility="Collapsed" Margin="16,0,0,0" VerticalAlignment="Center"
                               MouseLeftButtonUp="Cancel_Click"
                               ToolTip="Stops after the preset currently being processed"/>
                </Grid>

                <!-- success banner: what happened + one-click handoff to Explorer -->
                <Border x:Name="SaveBanner" Grid.Row="4" Visibility="Collapsed" CornerRadius="14"
                        Background="{DynamicResource B.PrimaryContainer}" Padding="16,12" Margin="0,14,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <controls:IconGlyph Grid.Column="0" IconName="Verified" Width="22" Height="22"
                                            Foreground="{DynamicResource B.OnPrimaryContainer}"
                                            VerticalAlignment="Center" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="SaveBannerTitle" Text="Conversion saved" FontSize="13" FontWeight="SemiBold"
                                       Foreground="{DynamicResource B.OnPrimaryContainer}"/>
                            <TextBlock x:Name="SavedToText" Style="{StaticResource Caption}" Foreground="{DynamicResource B.OnPrimaryContainer}"
                                       Opacity="0.8" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                        <TextBlock Grid.Column="2" Text="Open folder" Cursor="Hand" VerticalAlignment="Center"
                                   FontWeight="Medium" FontSize="12.5"
                                   Foreground="{DynamicResource B.OnPrimaryContainer}"
                                   MouseLeftButtonUp="OpenFolder_Click">
                            <TextBlock.TextDecorations>
                                <TextDecorationCollection>
                                    <TextDecoration Location="Underline"/>
                                </TextDecorationCollection>
                            </TextBlock.TextDecorations>
                        </TextBlock>
                    </Grid>
                </Border>
            </Grid>

            <!-- splitter -->
            <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" VerticalAlignment="Stretch"/>

            <!-- ================= RIGHT: insight + console ================= -->
            <DockPanel Grid.Column="2" Margin="8,0,0,0">
                <Border DockPanel.Dock="Top" Style="{StaticResource Card}" Padding="22" Margin="0,0,0,16">
                    <StackPanel>
                        <Rectangle Height="4" RadiusX="2" RadiusY="2" Margin="0,0,0,14" HorizontalAlignment="Stretch">
                            <Rectangle.Fill>
                                <!-- Primary → PrimaryContainer: a tonal same-hue
                                     fade that stays on-palette in every one of
                                     the 4 palettes. The old TertiaryContainer
                                     stop resolved to a foreign blue and read
                                     as an indeterminate progress bar. -->
                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                    <GradientStop Color="{DynamicResource P.Primary}" Offset="0"/>
                                    <GradientStop Color="{DynamicResource P.PrimaryContainer}" Offset="1"/>
                                </LinearGradientBrush>
                            </Rectangle.Fill>
                        </Rectangle>
                        <TextBlock Text="Intelligent Conversion" Style="{StaticResource SectionTitle}" FontSize="16" Margin="0,0,0,6"/>
                        <TextBlock Style="{StaticResource BodySecondary}" TextWrapping="Wrap"
                                   Text="Automatically detects missing or incompatible plugins against your profile and suggests removal. Presets are re-encoded to the selected target version."/>
                    </StackPanel>
                </Border>
                <controls:M3Console x:Name="Console"/>
            </DockPanel>

            <!-- drag feedback overlay (visual only — drop is handled by the page root) -->
            <Border x:Name="DragOverlay" Visibility="Collapsed" IsHitTestVisible="False" CornerRadius="26"
                    Background="{DynamicResource B.PrimaryContainer}" Opacity="0.95">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="28" ShadowDepth="6" Opacity="0.22"/>
                </Border.Effect>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <controls:IconGlyph IconName="Upload" Width="54" Height="54"
                                        Foreground="{DynamicResource B.OnPrimaryContainer}" HorizontalAlignment="Center"
                                        Margin="0,0,0,14"/>
                    <TextBlock Text="Release to load the presets" FontSize="19" FontWeight="SemiBold"
                               Foreground="{DynamicResource B.OnPrimaryContainer}" HorizontalAlignment="Center"
                               Margin="0,0,0,6"/>
                    <TextBlock Text=".ffx files and whole folders both work"
                               FontSize="12" Foreground="{DynamicResource B.OnPrimaryContainer}"
                               Opacity="0.8" HorizontalAlignment="Center"/>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
